generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

// ==================== PRODUCTS ====================
model Product {
  id        String @id @default(uuid()) @db.Uuid
  productId String @unique @db.VarChar(50)

  name        String  @db.VarChar(255)
  slug        String  @unique @db.VarChar(100)
  description String? @db.Text
  tagline     String? @db.VarChar(255)

  category ProductCategory
  status   ProductStatus

  version String? @db.VarChar(20)

  monthlyRevenue Decimal   @default(0) @db.Decimal(12, 2)
  totalUsers     Int       @default(0)
  activeUsers    Int       @default(0)
  priority       Int       @default(99)
  techStack      String[]  @db.Text
  tags           String[]  @db.Text
  features       Json?     @db.JsonB
  challenges     Json?     @db.JsonB
  opportunities  Json?     @db.JsonB
  links          Json?     @db.JsonB
  logoUrl        String?   @db.Text
  coverUrl       String?   @db.Text
  screenshots    String[]  @db.Text
  launchedAt     DateTime?
  metadata       Json      @default("{}") @db.JsonB
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  revenueTracking  RevenueTracking[]
  userGrowth       UserGrowth[]
  metrics          ProductMetric[]
  roadmapItems     RoadmapItem[]
  changelogEntries ChangelogEntry[]
  feedback         Feedback[]
  interactions     UserProductInteraction[]

  @@index([category])
  @@index([status])
  @@index([priority])
  @@map("products")
}

enum ProductCategory {
  EDUCATION
  HEALTH
  NEWS
  PRODUCTIVITY
  SOCIAL
  FINANCE
  AI
  ECOMMERCE
  SECURITY
  OTHER
}

enum ProductStatus {
  LIVE
  BUILDING
  PLANNED
  CONCEPT
  PAUSED
  ARCHIVED
}

// ==================== REVENUE TRACKING ====================
model RevenueTracking {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid

  // Date
  date DateTime @unique @db.Date

  // Revenue
  revenue Decimal @default(0) @db.Decimal(12, 2)

  // Users
  newUsers     Int @default(0)
  activeUsers  Int @default(0)
  churnedUsers Int @default(0)

  // MRR
  mrr Decimal @default(0) @db.Decimal(12, 2)

  // Churn Rate
  churnRate Decimal @default(0) @db.Decimal(5, 2)

  // Conversion
  trials         Int     @default(0)
  conversions    Int     @default(0)
  conversionRate Decimal @default(0) @db.Decimal(5, 2)

  createdAt DateTime @default(now())

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
  @@index([date])
  @@map("revenue_tracking")
}

// ==================== USER GROWTH ====================
model UserGrowth {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid

  // Date
  date DateTime @db.Date

  // Users
  totalUsers  Int @default(0)
  newUsers    Int @default(0)
  activeUsers Int @default(0)

  // Activity
  sessions           Int @default(0)
  avgSessionDuration Int @default(0) // in seconds

  // Engagement
  dau Int @default(0) // Daily Active Users
  wau Int @default(0) // Weekly Active Users
  mau Int @default(0) // Monthly Active Users

  createdAt DateTime @default(now())

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
  @@index([date])
  @@map("user_growth")
}

// ==================== PRODUCT METRICS ====================
model ProductMetric {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid

  // Metric Type
  metricType MetricType

  // Value
  value Decimal @db.Decimal(15, 2)

  // Date
  date DateTime @db.Date

  // Additional Data (JSON)
  metadata Json? @db.JsonB

  createdAt DateTime @default(now())

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, metricType, date])
  @@index([metricType, date])
  @@map("product_metrics")
}

enum MetricType {
  PAGE_VIEWS
  SIGN_UPS
  CONVERSIONS
  FEATURE_USAGE
  API_CALLS
  ERRORS
  RESPONSE_TIME
  UPTIME
  CUSTOMER_SATISFACTION
  NPS
  REVENUE_PER_USER
  LIFETIME_VALUE
}

// ==================== ROADMAP ====================
model RoadmapItem {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid

  // Item Details
  title       String @db.VarChar(255)
  description String @db.Text

  // Category
  category RoadmapCategory
  priority RoadmapPriority

  // Status
  status RoadmapStatus @default(PLANNED)

  // Votes
  votes Int @default(0)

  // Timeline
  quarter       String?   @db.VarChar(10) // Q1 2024
  estimatedDate DateTime?
  completedAt   DateTime?

  // Metadata
  metadata  Json     @default("{}") @db.JsonB
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([status])
  @@map("roadmap_items")
}

enum RoadmapCategory {
  FEATURE
  IMPROVEMENT
  BUG_FIX
  INTEGRATION
  PERFORMANCE
  SECURITY
}

enum RoadmapPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RoadmapStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ON_HOLD
}

// ==================== CHANGELOG ====================
model ChangelogEntry {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid

  // Version
  version String @db.VarChar(50)

  // Title & Description
  title       String @db.VarChar(255)
  description String @db.Text

  // Changes (JSON)
  changes Json @db.JsonB

  // Type
  type ChangeType

  // Publishing
  isPublished Boolean   @default(false)
  publishedAt DateTime?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isPublished, publishedAt])
  @@map("changelog_entries")
}

enum ChangeType {
  MAJOR
  MINOR
  PATCH
  HOTFIX
}

// ==================== FEEDBACK ====================
model Feedback {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  userId    String? @db.Uuid

  // Feedback Details
  type        FeedbackType
  title       String?      @db.VarChar(255)
  description String       @db.Text

  // Contact (for anonymous feedback)
  email String? @db.VarChar(255)

  // Severity
  severity FeedbackSeverity @default(MEDIUM)

  // Status
  status FeedbackStatus @default(NEW)

  // Votes
  upvotes Int @default(0)

  // Response
  response    String?   @db.Text
  respondedBy String?   @db.Uuid
  respondedAt DateTime?

  // Metadata
  browserInfo Json?    @db.JsonB
  metadata    Json     @default("{}") @db.JsonB
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([type, status])
  @@map("feedback")
}

enum FeedbackType {
  BUG
  FEATURE_REQUEST
  IMPROVEMENT
  QUESTION
  PRAISE
  COMPLAINT
}

enum FeedbackSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FeedbackStatus {
  NEW
  REVIEWING
  PLANNED
  IN_PROGRESS
  COMPLETED
  WONT_FIX
  DUPLICATE
}

// ==================== ANNOUNCEMENTS ====================
model Announcement {
  id String @id @default(uuid()) @db.Uuid

  // Title & Content
  title   String @db.VarChar(255)
  content String @db.Text

  // Type
  type AnnouncementType

  // Target (JSON)
  targetProducts String[] @db.Uuid
  targetUsers    String[] @db.Uuid // Empty = all users

  // Display
  priority      Int     @default(1)
  isDismissible Boolean @default(true)

  // Scheduling
  publishedAt DateTime?
  expiresAt   DateTime?

  // Status
  isActive Boolean @default(true)

  // Stats
  viewCount  Int @default(0)
  clickCount Int @default(0)

  // Metadata
  metadata  Json     @default("{}") @db.JsonB
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, publishedAt])
  @@map("announcements")
}

enum AnnouncementType {
  INFO
  WARNING
  SUCCESS
  ERROR
  UPDATE
  PROMOTION
}

// ==================== PORTFOLIO ITEMS ====================
model PortfolioItem {
  id String @id @default(uuid()) @db.Uuid

  // Project Details
  title       String @db.VarChar(255)
  description String @db.Text
  category    String @db.VarChar(100)

  // Media
  coverImage String?  @db.Text
  images     String[] @db.Text

  // Links
  liveUrl   String? @db.Text
  githubUrl String? @db.Text

  // Tech Stack
  techStack String[] @db.Text

  // Stats
  viewCount Int @default(0)
  likeCount Int @default(0)

  // Display
  isFeatured Boolean @default(false)
  order      Int     @default(999)

  // Metadata
  metadata  Json     @default("{}") @db.JsonB
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isFeatured])
  @@index([order])
  @@map("portfolio_items")
}

// ==================== ANALYTICS EVENTS ====================
model AnalyticsEvent {
  id String @id @default(uuid()) @db.Uuid

  // User
  userId    String? @db.Uuid
  sessionId String? @db.VarChar(100)

  // Product
  productSlug String @db.VarChar(50)

  // Event
  eventName String @db.VarChar(100)
  eventData Json?  @db.JsonB

  // Page
  pageUrl  String? @db.Text
  referrer String? @db.Text

  // Device
  userAgent String? @db.Text
  ipAddress String? @db.Inet

  // Location (JSON)
  location Json? @db.JsonB

  createdAt DateTime @default(now())

  @@index([productSlug, createdAt])
  @@index([eventName, createdAt])
  @@index([userId])
  @@map("analytics_events")
}

model UserProductInteraction {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @db.Uuid
  productId   String @db.Uuid
  productSlug String @db.VarChar(50)

  // Interaction Type
  type InteractionType

  // Data
  data     Json? @db.JsonB
  duration Int? // in seconds

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, type, createdAt])
  @@index([userId])
  @@index([productId])
  @@map("user_product_interactions")
}

enum InteractionType {
  VIEW
  CLICK
  FAVORITE
  SHARE
  FEEDBACK
  PURCHASE_INTENT
}
