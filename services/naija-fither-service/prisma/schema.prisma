generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("NAIJAFITHER_SERVICE_DATABASE_URL")
}

// ==================== USER PROFILES ====================
model UserProfile {
  id              String   @id @default(uuid())
  userId          String   @unique @db.Uuid
  
  // Physical Stats
  age             Int?
  heightCm        Decimal? @db.Decimal(5, 2)
  currentWeightKg Decimal? @db.Decimal(5, 2)
  targetWeightKg  Decimal? @db.Decimal(5, 2)
  
  // Activity & Goals
  activityLevel   ActivityLevel?
  fitnessGoal     FitnessGoal?
  weeklyWorkoutDays Int @default(3)
  
  // Dietary Preferences
  dietaryPreferences String[] @db.Text
  healthConditions   String[] @db.Text
  
  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  workoutSessions WorkoutSession[]
  dailyMeals      DailyMeal[]
  progressLogs    ProgressLog[]
  
  @@map("user_profiles")
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum FitnessGoal {
  WEIGHT_LOSS
  MUSCLE_GAIN
  ENDURANCE
  FLEXIBILITY
  GENERAL_FITNESS
  POSTPARTUM_RECOVERY
}

// ==================== WORKOUT PLANS ====================
model WorkoutPlan {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(255)
  description String?  @db.Text
  
  // Details
  difficulty  Difficulty
  durationWeeks Int    @default(4)
  focusAreas  String[] @db.Text
  equipmentNeeded String[] @db.Text
  
  // Media
  previewImageUrl String? @db.Text
  
  // Pricing
  isPremium   Boolean  @default(false)
  
  // Stats
  usageCount  Int      @default(0)
  rating      Decimal? @db.Decimal(3, 2)
  
  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  sessions    WorkoutSession[]
  exercises   WorkoutPlanExercise[]
  
  @@index([difficulty])
  @@index([isPremium])
  @@map("workout_plans")
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// ==================== EXERCISES ====================
model Exercise {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(255)
  description String   @db.Text
  
  // Details
  category    ExerciseCategory
  muscleGroups String[] @db.Text
  equipment   String?  @db.VarChar(100)
  
  // Instructions
  instructions Json    @db.JsonB
  
  // Media
  videoUrl    String?  @db.Text
  imageUrl    String?  @db.Text
  
  // Difficulty
  difficulty  Difficulty
  
  // Metadata
  caloriesPerMinute Decimal? @db.Decimal(5, 2)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  workoutPlans WorkoutPlanExercise[]
  
  @@index([category])
  @@index([difficulty])
  @@map("exercises")
}

enum ExerciseCategory {
  CARDIO
  STRENGTH
  FLEXIBILITY
  BALANCE
  HIIT
  YOGA
  PILATES
  DANCE
}

// ==================== WORKOUT PLAN EXERCISES (Junction) ====================
model WorkoutPlanExercise {
  id            String  @id @default(uuid())
  workoutPlanId String  @db.Uuid
  exerciseId    String  @db.Uuid
  
  // Order
  dayNumber     Int
  orderIndex    Int
  
  // Sets & Reps
  sets          Int?
  reps          Int?
  duration      Int?    // in seconds
  restTime      Int?    // in seconds
  
  // Notes
  notes         String? @db.Text
  
  // Relations
  workoutPlan WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  exercise    Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  
  @@unique([workoutPlanId, dayNumber, orderIndex])
  @@map("workout_plan_exercises")
}

// ==================== WORKOUT SESSIONS ====================
model WorkoutSession {
  id              String   @id @default(uuid())
  userId          String   @db.Uuid
  workoutPlanId   String?  @db.Uuid
  
  // Session Details
  sessionDate     DateTime @db.Date
  durationMinutes Int?
  caloriesBurned  Int?
  
  // Completed Exercises (JSON)
  completedExercises Json? @db.JsonB
  
  // User Notes
  userNotes       String?  @db.Text
  mood            Mood?
  energyLevel     Int?     @db.SmallInt
  
  createdAt       DateTime @default(now())
  
  // Relations
  userProfile  UserProfile  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  workoutPlan  WorkoutPlan? @relation(fields: [workoutPlanId], references: [id])
  
  @@unique([userId, sessionDate])
  @@index([userId])
  @@index([sessionDate])
  @@map("workout_sessions")
}

enum Mood {
  ENERGETIC
  MOTIVATED
  NEUTRAL
  TIRED
  EXHAUSTED
}

// ==================== MEAL PLANS ====================
model MealPlan {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(255)
  description String?  @db.Text
  
  // Nutrition Targets
  calorieTarget Int?
  proteinG      Int?
  carbsG        Int?
  fatG          Int?
  
  // Duration
  days        Int      @default(7)
  
  // Categories
  isNigerian  Boolean  @default(true)
  tags        String[] @db.Text
  
  // Pricing
  isPremium   Boolean  @default(false)
  
  // Stats
  usageCount  Int      @default(0)
  rating      Decimal? @db.Decimal(3, 2)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("meal_plans")
}

// ==================== DAILY MEALS ====================
model DailyMeal {
  id          String   @id @default(uuid())
  userId      String   @db.Uuid
  
  // Date & Type
  mealDate    DateTime @db.Date @default(now())
  mealType    MealType
  
  // Food Items (JSON)
  foodItems   Json     @db.JsonB
  
  // Nutrition
  totalCalories Int?
  totalProteinG Int?
  totalCarbsG   Int?
  totalFatG     Int?
  
  // Water Intake
  waterGlasses  Int?   @default(0)
  
  loggedAt    DateTime @default(now())
  
  // Relations
  userProfile UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  
  @@unique([userId, mealDate, mealType])
  @@index([userId, mealDate])
  @@map("daily_meals")
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

// ==================== PROGRESS LOGS ====================
model ProgressLog {
  id          String   @id @default(uuid())
  userId      String   @db.Uuid
  
  // Measurements
  weightKg    Decimal  @db.Decimal(5, 2)
  bodyFatPercentage Decimal? @db.Decimal(4, 2)
  
  // Body Measurements (in cm)
  waistCm     Decimal? @db.Decimal(5, 2)
  hipsCm      Decimal? @db.Decimal(5, 2)
  chestCm     Decimal? @db.Decimal(5, 2)
  thighCm     Decimal? @db.Decimal(5, 2)
  armCm       Decimal? @db.Decimal(5, 2)
  
  // Photos
  photoUrls   String[] @db.Text
  
  // Notes
  notes       String?  @db.Text
  
  logDate     DateTime @db.Date
  createdAt   DateTime @default(now())
  
  // Relations
  userProfile UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  
  @@index([userId, logDate])
  @@map("progress_logs")
}

// ==================== RECIPES ====================
model Recipe {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(255)
  description String?  @db.Text
  
  // Category
  category    RecipeCategory
  cuisine     String?  @db.VarChar(100)
  
  // Nutrition (per serving)
  servings    Int      @default(1)
  calories    Int?
  proteinG    Int?
  carbsG      Int?
  fatG        Int?
  
  // Preparation
  prepTime    Int?     // in minutes
  cookTime    Int?     // in minutes
  difficulty  Difficulty?
  
  // Ingredients (JSON)
  ingredients Json     @db.JsonB
  
  // Instructions (JSON)
  instructions Json    @db.JsonB
  
  // Media
  imageUrl    String?  @db.Text
  videoUrl    String?  @db.Text
  
  // Tags
  tags        String[] @db.Text
  isNigerian  Boolean  @default(true)
  
  // Stats
  viewCount   Int      @default(0)
  saveCount   Int      @default(0)
  rating      Decimal? @db.Decimal(3, 2)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([category])
  @@index([isNigerian])
  @@map("recipes")
}

enum RecipeCategory {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  DESSERT
  SMOOTHIE
  SALAD
  SOUP
}