generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

// ==================== COURSES ====================
model Course {
  id          String  @id @default(uuid()) @db.Uuid
  title       String  @db.VarChar(255)
  slug        String  @unique @db.VarChar(255)
  description String? @db.Text

  // Category
  category CourseCategory
  level    CourseLevel?

  // Pricing
  price Decimal @default(0) @db.Decimal(10, 2)

  // Duration
  durationHours Int?

  // Instructor
  instructorId String @db.Uuid

  // Media
  coverImageUrl String? @db.Text

  // Publishing
  isPublished Boolean   @default(false)
  publishedAt DateTime?

  // Metadata
  metadata  Json     @default("{}") @db.JsonB
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  modules     CourseModule[]
  enrollments Enrollment[]

  @@index([category])
  @@index([isPublished])
  @@index([instructorId])
  @@map("courses")
}

enum CourseCategory {
  JAMB
  WAEC
  NECO
  BUSINESS
  AI
  PROGRAMMING
  DESIGN
  MARKETING
}

enum CourseLevel {
  SS1
  SS2
  SS3
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// ==================== COURSE MODULES ====================
model CourseModule {
  id          String  @id @default(uuid()) @db.Uuid
  courseId    String  @db.Uuid
  title       String  @db.VarChar(255)
  description String? @db.Text

  // Order
  orderIndex Int

  // Duration
  estimatedMinutes Int?

  content Json @db.JsonB

  // Preview
  isPreview Boolean @default(false)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("course_modules")
}

// ==================== ENROLLMENTS ====================
model Enrollment {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @db.Uuid
  courseId String @db.Uuid

  // Dates
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  // Progress
  progressPercentage Int      @default(0)
  lastAccessed       DateTime @default(now())

  // Metadata
  metadata Json @default("{}") @db.JsonB

  // Relations
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

enum ExamType {
  JAMB
  WAEC
  NECO
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// ==================== USER PROGRESS ====================
model UserProgress {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  // Exam Details
  examType ExamType
  subject  String   @db.VarChar(100)

  // Stats
  questionsAttempted Int @default(0)
  correctAnswers     Int @default(0)
  totalTimeSpent     Int @default(0) // in seconds

  // Streak
  streakDays   Int      @default(0)
  lastPractice DateTime @default(now())

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, examType, subject])
  @@index([userId])
  @@map("user_progress")
}

// ==================== QUIZZES ====================
model Quiz {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  // Quiz Details
  examType ExamType
  subject  String   @db.VarChar(100)

  // Questions (Array of IDs)
  questionIds String[] @db.Uuid

  // Results
  score          Int?
  totalQuestions Int
  timeSpent      Int? // in seconds

  // Status
  status QuizStatus @default(IN_PROGRESS)

  // Dates
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  // Answers (JSON)
  answers Json? @db.JsonB

  @@index([userId])
  @@index([status])
  @@map("quizzes")
}

enum QuizStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}
