generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("BOLDMIND_OS_SERVICE_DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  preferences  UserPreferences?
  workspaces   Workspace[]
  focusLogs    FocusSession[]
  analytics    UserAnalytics?
  subscription Subscription?
}

model UserPreferences {
  id            String  @id @default(uuid())
  userId        String  @unique
  adhdMode      Boolean @default(false)
  dyslexiaMode  Boolean @default(false)
  focusMinutes Int     @default(25)
  breakMinutes Int     @default(5)

  user User @relation(fields: [userId], references: [id])
}

model Workspace {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  captures  Capture[]
  tasks     Task[]
  knowledge KnowledgeNode[]
  pipelines ContentPipeline[]

  user User @relation(fields: [userId], references: [id])
}

model Capture {
  id          String      @id @default(uuid())
  workspaceId String
  type        CaptureType
  content     String?
  mediaUrl    String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

enum CaptureType {
  TEXT
  VOICE
  IMAGE
  LINK
}

model Task {
  id          String     @id @default(uuid())
  workspaceId String
  title       String
  description String?
  status      TaskStatus @default(BACKLOG)
  priority    Int        @default(0)
  dueAt       DateTime?
  createdAt   DateTime   @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

enum TaskStatus {
  BACKLOG
  ACTIVE
  DONE
  DROPPED
}

model FocusSession {
  id        String   @id @default(uuid())
  userId    String
  duration  Int
  startedAt DateTime
  endedAt   DateTime?

  user User @relation(fields: [userId], references: [id])
}

model KnowledgeNode {
  id          String        @id @default(uuid())
  workspaceId String
  title       String
  content     String?
  type        KnowledgeType
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  edgesFrom  KnowledgeEdge[] @relation("from")
  edgesTo    KnowledgeEdge[] @relation("to")
}

model KnowledgeEdge {
  id     String @id @default(uuid())
  fromId String
  toId   String
  label  String?

  from KnowledgeNode @relation("from", fields: [fromId], references: [id])
  to   KnowledgeNode @relation("to", fields: [toId], references: [id])
}

enum KnowledgeType {
  NOTE
  IDEA
  PROJECT
  RESOURCE
}

model ContentPipeline {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  stages      Json
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model UserAnalytics {
  id              String @id @default(uuid())
  userId          String @unique
  totalFocusTime  Int    @default(0)
  tasksCompleted  Int    @default(0)
  capturesCreated Int    @default(0)

  user User @relation(fields: [userId], references: [id])
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String   @unique
  plan      OSPlan
  status    SubStatus
  startedAt DateTime @default(now())
  expiresAt DateTime?

  user User @relation(fields: [userId], references: [id])
}

enum OSPlan {
  FREE
  PRO
  ELITE
}

enum SubStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}
