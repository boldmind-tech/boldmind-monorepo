{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./*"
            ],
            "@boldmind/*": [
                "../../packages/*/src"
            ]
        },
        "incremental": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "allowJs": true,
        "noEmit": true,
        "jsx": "preserve"
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts",
        "**/*.mts"
, "next.config.mjs"    ],
    "exclude": [
        "node_modules"
    ]
}