{
    "name": "",
    "framework": "nextjs",
    "buildCommand": "pnpm turbo run build --filter=@boldmind/planai-business-planning --cache-dir=.turbo",
    "outputDirectory": ".next",
    "installCommand": "pnpm install --no-frozen-lockfile --prefer-offline",
    "devCommand": "pnpm turbo run dev --filter=@boldmind/planai-credibility-hubs",
    "regions": [
        "fra1"
    ],
    "env": {
        "NEXT_PUBLIC_API_URL": "https://api.planai.boldmind.ng",
        "NEXT_PUBLIC_SITE_URL": "https://planai.boldmind.ng/credibility"
    },
    "alias": [
        "planai.boldmind.ng/credibility",
        "www.planai.boldmind.ng/credibility"
    ]
}