{
  "name": "@boldmind/utils",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.mts"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "npx rimraf dist && tsdown",
    "dev": "tsdown --watch",
    "clean": "npx rimraf dist node_modules",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cookie": "^1.1.1",
    "crypto": "^1.0.1",
    "date-fns": "^3.0.0",
    "tsdown": "^0.20.1"
  },
  "devDependencies": {
    "@types/axios": "^0.14.0",
    "@types/cookie": "^1.0.0",
    "@types/node": "20.19.30",
    "typescript": "^5.4.5"
  }
}