{
  "name": "@boldmind/api-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist node_modules",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "@boldmind/config": "workspace:*",
    "@boldmind/auth": "workspace:*",
    "@boldmind/utils": "workspace:*",
    "@supabase/supabase-js": "^2.39.0",
    "tsdown": "^0.20.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.3",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "next": "14.2.35",
    "react": "18.2.0"
  }
}