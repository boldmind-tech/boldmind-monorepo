{
  "name": "@boldmind/auth",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist node_modules",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@boldmind/config": "workspace:*",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.91.1",
    "@types/cookie": "^1.0.0",
    "@types/react": "18.3.27",
    "cookie": "^1.1.1",
    "tsdown": "^0.20.1"
  },
  "devDependencies": {
    "@types/node": "20.19.30",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "next": "14.2.35",
    "react": "18.2.0"
  },
  "references": [
    {
      "path": "../config"
    }
  ]
}