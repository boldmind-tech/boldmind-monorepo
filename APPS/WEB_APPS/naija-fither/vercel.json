{
  "name": "naija-fither",
  "framework": "nextjs",
  "buildCommand": "cd APPS/WEB_APPS/naija-fither && pnpm run build",
  "outputDirectory": "APPS/WEB_APPS/naija-fither/.next",
  "installCommand": "cd APPS/WEB_APPS/naija-fither && pnpm install --filter=@boldmind/naija-fither...",
  "devCommand": "cd APPS/WEB_APPS/naija-fither && pnpm run dev",
  "regions": [
    "fra1"
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://api.boldmind.ng",
    "NEXT_PUBLIC_SITE_URL": "https://fit.boldmind.ng"
  },
  "alias": [
    "fit.boldmind.ng",
    "www.fit.boldmind.ng"
  ]
}