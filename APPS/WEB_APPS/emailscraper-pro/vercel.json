{
  "name": "emailscraper-pro",
  "framework": "nextjs",
  "buildCommand": "pnpm turbo run build --filter=@boldmind/emailscraper-pro --cache-dir=.turbo",
  "outputDirectory": ".next",
  "installCommand": "pnpm install --no-frozen-lockfile --prefer-offline",
  "devCommand": "pnpm turbo run dev --filter=@boldmind/emailscraper-pro",
  "regions": [
    "fra1"
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://api.boldmind.ng",
    "NEXT_PUBLIC_SITE_URL": "https://email.boldmind.ng"
  },
  "alias": [
    "email.boldmind.ng",
    "www.email.boldmind.ng"
  ]
}