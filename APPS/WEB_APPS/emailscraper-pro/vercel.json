{
  "name": "emailscraper-pro",
  "framework": "nextjs",
  "buildCommand": "cd APPS/WEB_APPS/emailscraper-pro && pnpm run build",
  "outputDirectory": "APPS/WEB_APPS/emailscraper-pro/.next",
  "installCommand": "pnpm install --filter=@boldmind/emailscraper-pro...",
  "devCommand": "cd APPS/WEB_APPS/emailscraper-pro && pnpm run dev",
  "regions": [
    "fra1"
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://api.boldmind.ng",
    "NEXT_PUBLIC_SITE_URL": "https://email.boldmind.ng"
  },
  "alias": [
    "email.boldmind.ng",
    "www.email.boldmind.ng"
  ]
}