{
    "buildCommand": "cd APPS/WEB_APPS/boldmind-hub && pnpm install && pnpm build",
    "devCommand": "cd APPS/WEB_APPS/boldmind-hub && pnpm dev",
    "installCommand": "pnpm install --no-frozen-lockfile",
    "framework": "nextjs",
    "outputDirectory": "APPS/WEB_APPS/boldmind-hub/.next",
    "regions": [
        "iad1"
    ],
    "env": {
        "NEXT_PUBLIC_APP_NAME": "boldmind-hub",
        "NEXT_PUBLIC_APP_URL": "https://boldmind.ng",
        "NEXT_PUBLIC_SITE_NAME": "BoldMind hub",
        "NEXT_PUBLIC_SUPABASE_URL": "@supabase_url",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY": "@supabase_anon_key",
        "NEXT_PUBLIC_API_URL": "@api_gateway_url",
        "NODE_ENV": "production"
    }
}