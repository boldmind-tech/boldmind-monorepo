{
  "name": "boldmind-hub",
  "framework": "nextjs",
  "buildCommand": "pnpm -w run build:boldmind-hub-deps && pnpm -w run vercel:boldmind-hub",
  "outputDirectory": "APPS/WEB_APPS/boldmind-hub/.next",
  "installCommand": "pnpm install --filter=@boldmind/boldmind-hub...",
  "devCommand": "cd APPS/WEB_APPS/boldmind-hub && pnpm run dev",
  "regions": [
    "fra1"
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://api.boldmind.ng",
    "NEXT_PUBLIC_SITE_URL": "https://boldmind.ng"
  },
  "alias": [
    "boldmind.ng",
    "www.boldmind.ng"
  ]
}