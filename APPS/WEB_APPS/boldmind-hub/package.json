{
  "name": "@boldmind/boldmind-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "pnpm --filter '@boldmind/ui' --filter '@boldmind/utils' --filter '@boldmind/auth' --filter '@boldmind/analytics' --filter '@boldmind/api-client' --filter '@boldmind/seo' --filter '@boldmind/config' build",
    "build": "next build",
    "deploy": "cd ../../.. && pnpm turbo build --filter=@boldmind/boldmind-hub",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@boldmind/analytics": "workspace:*",
    "@boldmind/api-client": "workspace:*",
    "@boldmind/auth": "workspace:*",
    "@boldmind/seo": "workspace:*",
    "@boldmind/ui": "workspace:*",
    "@boldmind/utils": "workspace:*",
    "@boldmind/config": "workspace:*",
    "autoprefixer": "^10.4.16",
    "clsx": "^2.0.0",
    "cookie": "^1.1.1",
    "framer-motion": "^12.29.2",
    "lucide-react": "^0.563.0",
    "date-fns": "^3.0.0",
    "next": "^14.2.0",
    "postcss": "^8.4.33",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sonner": "^2.0.3",
    "tailwindcss": "^3.4.1",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.1.0"
  }
}