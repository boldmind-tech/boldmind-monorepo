{
  "name": "educenter",
  "framework": "nextjs",
  "buildCommand": "pnpm turbo run build --filter=@boldmind/educenter --cache-dir=.turbo",
  "outputDirectory": ".next",
  "installCommand": "pnpm install --no-frozen-lockfile --prefer-offline",
  "devCommand": "pnpm turbo run dev --filter=@boldmind/educenter",
  "regions": [
    "fra1"
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://api.educenter.com.ng",
    "NEXT_PUBLIC_SITE_URL": "https://educenter.com.ng"
  },
  "alias": [
    "educenter.com.ng",
    "www.educenter.com.ng"
  ]
}