{
  "name": "educenter",
  "framework": "nextjs",
  "buildCommand": "pnpm run build:shared && pnpm -w run vercel:educenter",
  "outputDirectory": "APPS/WEB_APPS/educenter/.next",
  "installCommand": "pnpm install --filter=@boldmind/educenter...",
  "devCommand": "cd APPS/WEB_APPS/educenter && pnpm run dev",
  "regions": [
    "fra1"
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://api.educenter.com.ng",
    "NEXT_PUBLIC_SITE_URL": "https://educenter.com.ng"
  },
  "alias": [
    "educenter.com.ng",
    "www.educenter.com.ng"
  ]
}