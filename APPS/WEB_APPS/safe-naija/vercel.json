{
  "name": "safe-naija",
  "framework": "nextjs",
  "buildCommand": "cd APPS/WEB_APPS/safe-naija && pnpm run build",
  "outputDirectory": "APPS/WEB_APPS/safe-naija/.next",
  "installCommand": "pnpm install --filter=@boldmind/safe-naija...",
  "devCommand": "cd APPS/WEB_APPS/safe-naija && pnpm run dev",
  "regions": [
    "fra1"
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://api.boldmind.ng",
    "NEXT_PUBLIC_SITE_URL": "https://safe.boldmind.ng"
  },
  "alias": [
    "safe.boldmind.ng",
    "www.safe.boldmind.ng"
  ]
}