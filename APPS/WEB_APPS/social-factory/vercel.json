{
  "name": "socail-factory",
  "framework": "nextjs",
  "buildCommand": "pnpm turbo run build --filter=@boldmind/social-factory --cache-dir=.turbo",
  "outputDirectory": ".next",
  "installCommand": "pnpm install --no-frozen-lockfile --prefer-offline",
  "devCommand": "pnpm turbo run dev --filter=@boldmind/social-factory",
  "regions": [
    "fra1"
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://api.boldmind.ng",
    "NEXT_PUBLIC_SITE_URL": "https://socail.boldmind.ng"
  },
  "alias": [
    "socail.boldmind.ng",
    "www.socail.boldmind.ng"
  ]
}