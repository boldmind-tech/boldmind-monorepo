{
  "name": "planai-landing",
  "framework": "nextjs",
  "buildCommand": "cd APPS/WEB_APPS/PLANAI_SUITE/planai-landing && pnpm run build",
  "outputDirectory": "APPS/WEB_APPS/PLANAI_SUITE/planai-landing/.next",
  "installCommand": "pnpm install --filter=@boldmind/planai-landing...",
  "devCommand": "cd APPS/WEB_APPS/PLANAI_SUITE/planai-landing && pnpm run dev",
  "regions": [
    "fra1"
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://api.planai.boldmind.ng",
    "NEXT_PUBLIC_SITE_URL": "https://planai.boldmind.ng"
  },
  "alias": [
    "planai.boldmind.ng",
    "www.planai.boldmind.ng"
  ]
}