{
  "name": "planai-landing",
  "framework": "nextjs",
  "buildCommand": "pnpm turbo run build --filter=@boldmind/planai-landing --cache-dir=.turbo",
  "outputDirectory": ".next",
  "installCommand": "pnpm install --no-frozen-lockfile --prefer-offline",
  "devCommand": "pnpm turbo run dev --filter=@boldmind/planai-landing",
  "regions": [
    "fra1"
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://api.planai.boldmind.ng",
    "NEXT_PUBLIC_SITE_URL": "https://planai.boldmind.ng"
  },
  "alias": [
    "planai.boldmind.ng",
    "www.planai.boldmind.ng"
  ]
}