{
  "name": "amebogist",
  "framework": "nextjs",
  "buildCommand": "pnpm turbo run build --filter=@boldmind/amebogist... --cache-dir=.turbo",
  "outputDirectory": ".next",
  "installCommand": "pnpm install --frozen-lockfile --prefer-offline",
  "devCommand": "pnpm turbo run dev --filter=@boldmind/amebogist...",
  "regions": [
    "fra1"
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://api.amebogist.ng",
    "NEXT_PUBLIC_SITE_URL": "https://amebogist.ng"
  },
  "alias": [
    "amebogist.ng",
    "www.amebogist.ng"
  ]
}