{
    "buildCommand": "cd APPS/WEB_APPS/amebogist && pnpm install && pnpm build",
    "devCommand": "cd APPS/WEB_APPS/amebogist && pnpm dev",
    "installCommand": "pnpm install",
    "framework": "nextjs",
    "outputDirectory": "APPS/WEB_APPS/amebogist/.next",
    "regions": [
        "iad1"
    ],
    "env": {
        "NEXT_PUBLIC_APP_NAME": "amebogist",
        "NEXT_PUBLIC_APP_URL": "https://amebogist.com",
        "NEXT_PUBLIC_SITE_NAME": "Amebogist - Social Media Intelligence",
        "NEXT_PUBLIC_SUPABASE_URL": "@supabase_url",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY": "@supabase_anon_key",
        "NEXT_PUBLIC_API_URL": "@api_gateway_url",
        "NODE_ENV": "production"
    }
}