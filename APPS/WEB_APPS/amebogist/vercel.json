{
  "name": "amebogist",
  "framework": "nextjs",
  "buildCommand": "pnpm -w run build:amebogist-deps && pnpm -w run vercel:amebogist",
  "outputDirectory": "APPS/WEB_APPS/amebogist/.next",
  "installCommand": "pnpm install --filter=@boldmind/amebogist...",
  "devCommand": "cd APPS/WEB_APPS/amebogist && pnpm run dev",
  "regions": [
    "fra1"
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://api.amebogist.ng",
    "NEXT_PUBLIC_SITE_URL": "https://amebogist.ng"
  },
  "alias": [
    "amebogist.ng",
    "www.amebogist.ng"
  ]
}