{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.json",
    "tailwind.config.js",
    "postcss.config.js",
    "package.json",
    "pnpm-lock.yaml"
  ],
  "pipeline": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "cache": true
    },
    "@boldmind/database#build": {
      "outputs": [
        "dist/**"
      ],
      "cache": true
    },
    "@boldmind/ui#build": {
      "outputs": [
        "dist/**"
      ],
      "cache": true
    },
    "@boldmind/utils#build": {
      "dependsOn": [
        "@boldmind/database#build"
      ],
      "outputs": [
        "dist/**"
      ],
      "cache": true
    },
    "@boldmind/auth#build": {
      "dependsOn": [
        "@boldmind/database#build",
        "@boldmind/utils#build"
      ],
      "outputs": [
        "dist/**"
      ],
      "cache": true
    },
    "@boldmind/seo#build": {
      "dependsOn": [
        "@boldmind/utils#build"
      ],
      "outputs": [
        "dist/**"
      ],
      "cache": true
    },
    "@boldmind/analytics#build": {
      "dependsOn": [
        "@boldmind/utils#build"
      ],
      "outputs": [
        "dist/**"
      ],
      "cache": true
    },
    "@boldmind/ai#build": {
      "dependsOn": [
        "@boldmind/utils#build"
      ],
      "outputs": [
        "dist/**"
      ],
      "cache": true
    },
    "@boldmind/payments#build": {
      "dependsOn": [
        "@boldmind/utils#build"
      ],
      "outputs": [
        "dist/**"
      ],
      "cache": true
    },
    "@boldmind/api-client#build": {
      "dependsOn": [
        "@boldmind/utils#build",
        "@boldmind/auth#build"
      ],
      "outputs": [
        "dist/**"
      ],
      "cache": true
    },
    "@boldmind/amebogist#build": {
      "dependsOn": [
        "@boldmind/ui#build",
        "@boldmind/auth#build",
        "@boldmind/utils#build"
      ]
    },
    "@boldmind/boldmind-hub#build": {
      "dependsOn": [
        "@boldmind/ui#build",
        "@boldmind/auth#build",
        "@boldmind/utils#build",
        "@boldmind/database#build"
      ]
    },
    "@boldmind/educenter#build": {
      "dependsOn": [
        "@boldmind/ui#build",
        "@boldmind/auth#build",
        "@boldmind/utils#build",
        "@boldmind/database#build"
      ]
    },
    "@boldmind/planai-landing#build": {
      "dependsOn": [
        "@boldmind/ui#build",
        "@boldmind/auth#build",
        "@boldmind/utils#build"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "type-check": {
      "outputs": []
    }
  }
}