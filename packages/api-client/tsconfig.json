{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "incremental": true,
    "noEmit": false,
    "types": [
      "node"
    ] // prevents random implicit libs like 'cookie'
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "dist",
    "node_modules"
  ],
  "references": [
    {
      "path": "../utils",
    }, // ← add this – points to utils/tsconfig.json
    {
      "path": "../auth",
    }, // ← add this – points to utils/tsconfig.json
    {
      "path": "../config",
    }, // ← add this – points to utils/tsconfig.json
  ]
}