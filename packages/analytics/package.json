{
  "name": "@boldmind/analytics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "pnpm exec rimraf dist node_modules",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@boldmind/utils": "workspace:*",
    "cookie": "^1.1.1",
    "mixpanel-browser": "^2.0.0",
    "posthog-js": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "tsdown": "^0.20.1",
    "typescript": "^5.3.3"
  }
}