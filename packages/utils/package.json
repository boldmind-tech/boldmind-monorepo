{
  "name": "@boldmind/utils",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./social": {
      "import": "./dist/social.mjs",
      "require": "./dist/social.cjs",
      "types": "./dist/social.d.ts"
    },
    "./constants": {
      "import": "./dist/constants.mjs",
      "require": "./dist/constants.cjs",
      "types": "./dist/constants.d.ts"
    },
    "./styles": {
      "import": "./dist/styles/theme.mjs",
      "require": "./dist/styles/theme.cjs",
      "types": "./dist/styles/theme.d.ts"
    },
    "./domains": {
      "import": "./dist/domains.mjs",
      "require": "./dist/domains.cjs",
      "types": "./dist/domains.d.ts"
    },
    "./database-config": {
      "import": "./dist/database-config.mjs",
      "require": "./dist/database-config.cjs",
      "types": "./dist/database-config.d.ts"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "rm -rf dist && tsdown",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist node_modules",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cookie": "^1.1.1",
    "date-fns": "^3.0.0",
    "tsdown": "^0.20.1"
  },
  "devDependencies": {
    "@types/axios": "^0.14.0",
    "@types/node": "20.19.30",
    "typescript": "^5.4.5"
  }
}