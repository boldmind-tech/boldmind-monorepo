{
  "name": "@boldmind/utils",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./social": {
      "import": {
        "types": "./dist/social/index.d.mts",
        "default": "./dist/social/index.mjs"
      },
      "require": {
        "types": "./dist/social/index.d.cts",
        "default": "./dist/social/index.cjs"
      }
    },
    "./constants": {
      "import": {
        "types": "./dist/constants/index.d.mts",
        "default": "./dist/constants/index.mjs"
      },
      "require": {
        "types": "./dist/constants/index.d.cts",
        "default": "./dist/constants/index.cjs"
      }
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "build:all": "pnpm build && pnpm build:types",
    "dev": "tsup --watch",
    "lint": "eslint . --ext ts,tsx",
    "clean": "rm -rf .turbo dist node_modules"
  },
  "dependencies": {
    "date-fns": "^3.0.0",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "20.19.29",
    "typescript": "^5.4.5",
    "@types/axios": "^0.14.0",
    "tsup": "^7.2.0"
  }
}