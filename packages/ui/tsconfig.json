{
  "extends": "../../tsconfig.frontend.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx", // ✅ Correct for React
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@boldmind/*": [
        "../*/src"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "references": [
    {
      "path": "../utils"
    }
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".turbo"
  ]
}