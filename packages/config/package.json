{
  "name": "@boldmind/config",
  "version": "1.0.0",
  "private": true,
  "description": "BoldMind Config",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./tailwind": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "rimraf dist node_modules",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@types/node": "20.19.30",
    "cookie": "^1.1.1",
    "tsdown": "^0.20.1",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}