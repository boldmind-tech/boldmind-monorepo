{
  "name": "@boldmind/config",
  "version": "1.0.0",
  "private": true,
  "description": "BoldMind Config",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "pnpm exec rimraf dist && tsdown",
    "dev": "tsdown --watch",
    "clean": "pnpm exec rimraf dist node_modules",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@types/node": "20.19.30",
    "cookie": "^1.1.1"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "tsdown": "^0.20.1",
    "typescript": "^5.4.5"
  }
}