{
    "extends": "../../tsconfig.base.json", // or .base / whatever your shared base is
    "compilerOptions": {
        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": true, // ← only emit .d.ts, no .js (libs usually do this)
        "outDir": "./dist",
        "rootDir": "./src",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx", // if api-client has any JSX
        "incremental": true,
        "noEmit": false,
        "types": [
            "node"
        ] // prevents random implicit libs like 'cookie'
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "**/*.test.ts",
        "**/*.spec.ts",
        "dist",
        "node_modules"
    ]
}