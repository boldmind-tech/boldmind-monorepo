{
  "name": "boldmind-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "dev:all": "turbo run dev --parallel",
    "build:all": "turbo run build --parallel",
    "build:web": "turbo run build --filter='./apps/*'",
    "build:api": "turbo run build --filter='./service'",
    "build:packages": "turbo run build --filter='./packages/*'",
    "build:shared": "turbo run build --filter='./packages/*'",
    "build:auth": "pnpm --filter '@boldmind/auth' run build",
    "build:utils": "pnpm --filter '@boldmind/utils' run build",
    "build:api-client": "pnpm --filter '@boldmind/api-client' run build",
    "dev:hub": "turbo run dev --filter='./apps/boldmind-hub'",
    "dev:amebogist": "turbo run dev --filter='./apps/amebogist'",
    "dev:educenter": "turbo run dev --filter='./apps/educenter'",
    "dev:os": "turbo run dev --filter='./apps/boldmind-os'",
    "dev:fit": "turbo run dev --filter='./apps/naija-fit'",
    "dev:tools": "turbo run dev --filter='./apps/boldmind-tools'",
    "dev:concepts": "turbo run dev --filter='./apps/boldmind-concepts'",
    "dev:planai": "turbo run dev --filter='./apps/planai-suite'",
    "dev:amebo-studio": "turbo run dev --filter='./apps/amebo-studio'",
    "dev:skillgig": "turbo run dev --filter='./apps/skillgig'",
    "dev:api": "turbo run dev --filter='./service'",
    "dev:service": "pnpm run build:packages && turbo run dev --filter='./service'",
    "prisma:generate": "pnpm run --filter './service' prisma:generate",
    "prisma:migrate": "pnpm run --filter './service' prisma:migrate",
    "prisma:studio": "pnpm run --filter './service' prisma:studio",
    "prisma:push": "pnpm run --filter './service' prisma:push",
    "vercel:planai": "turbo run build --filter='./apps/planai-suite'",
    "vercel:boldmind-hub": "turbo run build --filter='./apps/boldmind-hub'",
    "vercel:amebogist": "turbo run build --filter='./apps/amebogist'",
    "vercel:educenter": "turbo run build --filter='./apps/educenter'",
    "deploy:all": "sh ./infrastructure/scripts/deploy-all.sh",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "clean": "rimraf node_modules /node_modules",
    "health": "echo 'Checking monorepo health...' && pnpm run type-check && pnpm run lint && echo '✅ All checks passed'"
  },
  "dependencies": {
    "tsdown": "^0.20.1"
  },
  "devDependencies": {
    "@types/cookie": "^1.0.0",
    "@types/node": "20.19.30",
    "framer-motion": "^12.34.3",
    "prettier": "^3.2.5",
    "rimraf": "^6.1.3",
    "turbo": "^2.1.3",
    "typescript": "^5.3.3",
    "prisma": "7.3.0",
    "@prisma/client": "7.3.0",
    "@nestjs/cli": "^10.4.9"
  },
  "pnpm": {
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "next": "14.2.35",
      "typescript": "5.9.3",
      "@types/react": "18.3.27",
      "@types/react-dom": "18.3.7",
      "@types/node": "20.19.30",
      "mongoose": "^8.7.0",
      "mongodb": "^6.10.0",
      "prisma": "7.3.0",
      "@prisma/client": "7.3.0"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ]
    }
  }
}