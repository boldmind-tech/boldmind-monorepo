{
  "name": "boldmind-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@APPS/WEB_APPS/*",
    "build:api": "turbo run build --filter=@SERVICES/*",
    "dev:planai": "turbo run dev --filter=./APPS/WEB_APPS/PLANAI_SUITE/*",
    "dev:concepts": "turbo run dev --filter=./APPS/CONCEPT_APPS/*",
    "build:shared": "turbo run build --filter=./PACKAGES/*",
    "build:boldmind-hub-deps": "turbo run build --filter={@boldmind/ui} --filter={@boldmind/auth} --filter={@boldmind/utils} --filter={@boldmind/analytics} --filter={@boldmind/payments} --filter={@boldmind/api-client}",
    "vercel:planai-landing": "turbo run build --filter=./PACKAGES/ui --filter=./PACKAGES/utils --filter=...{@boldmind/planai-landing}",
    "vercel:boldmind-hub": "turbo run build --filter=./PACKAGES/ui --filter=./PACKAGES/utils --filter=./PACKAGES/auth --filter=./PACKAGES/analytics --filter=...{@boldmind/boldmind-hub}",
    "vercel:amebogist": "turbo run build --filter=./PACKAGES/ui --filter=./PACKAGES/utils --filter=./PACKAGES/auth --filter=...{@boldmind/amebogist}",
    "vercel:educenter": "turbo run build --filter=./PACKAGES/ui --filter=./PACKAGES/utils --filter=./PACKAGES/auth --filter=./PACKAGES/ai --filter=./PACKAGES/payments --filter=...{@boldmind/educenter}",
    "build:amebogist-deps": "turbo run build --filter={@boldmind/ui} --filter={@boldmind/auth} --filter={@boldmind/utils}",
    "build:educenter-deps": "turbo run build --filter={@boldmind/ui} --filter={@boldmind/auth} --filter={@boldmind/utils} --filter={@boldmind/ai} --filter={@boldmind/payments}",
    "build:planai-landing-deps": "turbo run build --filter={@boldmind/ui} --filter={@boldmind/utils}",
    "build:planai-receptionist-deps": "turbo run build --filter={@boldmind/ui} --filter={@boldmind/auth} --filter={@boldmind/utils} --filter={@boldmind/payments} --filter={@boldmind/api-client}",
    "vercel:planai-receptionist": "turbo run build --filter=...{@boldmind/planai-receptionist} --concurrency=1",
    "dev:api": "turbo run dev --filter=@SERVICES/*",
    "db:generate": "pnpm --filter @PACKAGES/database prisma generate",
    "db:migrate": "pnpm --filter @PACKAGES/database prisma migrate dev",
    "db:migrate:prod": "pnpm --filter @PACKAGES/database prisma migrate deploy",
    "db:seed": "pnpm --filter @PACKAGES/database prisma db seed",
    "db:studio": "pnpm --filter @PACKAGES/database prisma studio",
    "db:reset": "pnpm --filter @PACKAGES/database prisma migrate reset",
    "api:gateway": "pnpm --filter @SERVICES/api-gateway dev",
    "api:educenter": "pnpm --filter @SERVICES/educenter-service dev",
    "api:receptionist": "pnpm --filter @SERVICES/receptionist-service dev",
    "deploy:all": "sh ./tools/scripts/deploy-all.sh",
    "deploy:educenter": "sh ./tools/scripts/deploy-educenter.sh",
    "deploy:receptionist": "sh ./tools/scripts/deploy-receptionist.sh",
    "deploy:api-gateway": "sh ./tools/scripts/deploy-api-gateway.sh",
    "deploy:api-educenter": "sh ./tools/scripts/deploy-api-educenter.sh",
    "deploy:api-receptionist": "sh ./tools/scripts/deploy-api-receptionist.sh",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "rm -rf node_modules && rm -rf **/node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "dev:planai-landing": "turbo run dev --filter=./APPS/WEB_APPS/PLANAI_SUITE/planai-landing",
    "dev:planai-receptionist": "turbo run dev --filter=./APPS/WEB_APPS/PLANAI_SUITE/receptionist",
    "dev:planai-credibility-hubs": "turbo run dev --filter=./APPS/WEB_APPS/PLANAI_SUITE/credibility-hubs",
    "dev:planai-business-planning": "turbo run dev --filter=./APPS/WEB_APPS/PLANAI_SUITE/business-planning",
    "dev:afrohustle-os": "turbo run dev --filter=./APPS/CONCEPT_APPS/afrohustle-os",
    "dev:naijagig-matcher": "turbo run dev --filter=./APPS/CONCEPT_APPS/naijagig-matcher",
    "dev:kolo-ai": "turbo run dev --filter=./APPS/CONCEPT_APPS/kolo-ai",
    "dev:all": "turbo run dev --parallel",
    "install:all": "pnpm install && pnpm -r install",
    "update:deps": "pnpm update --latest --recursive --workspace-root",
    "check:deps": "pnpm -r exec npm outdated",
    "audit:deps": "pnpm audit --recursive",
    "fix:deps": "pnpm dedupe",
    "stats": "turbo run stats",
    "graph": "turbo run build --graph",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "typescript": "^5.3.3",
    "turbo": "^1.13.2",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.1.0",
    "prettier": "^3.1.1",
    "prettier-plugin-tailwindcss": "^0.5.9",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "autoprefixer": "^10.4.16",
    "@nestjs/cli": "^10.3.2",
    "@nestjs/common": "^10.3.3",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.3",
    "@nestjs/platform-express": "^10.3.3",
    "@nestjs/swagger": "^7.3.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "next": "^14.2.0",
    "framer-motion": "^11.0.5",
    "lucide-react": "^0.309.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.2.0",
    "axios": "^1.6.7",
    "@tanstack/react-query": "^5.17.0",
    "zustand": "^4.4.7",
    "react-hook-form": "^7.49.3",
    "zod": "^3.22.4",
    "@hookform/resolvers": "^3.3.2"
  },
  "pnpm": {
    "overrides": {
      "react": "^18.2.0",
      "react-dom": "^18.2.0",
      "next": "^14.2.0",
      "typescript": "^5.3.3",
      "@types/react": "^18.2.61",
      "@types/react-dom": "^18.2.19",
      "@types/node": "^20.11.5",
      "mongoose": "^8.7.0",
      "mongodb": "^6.10.0"
    }
  }
}