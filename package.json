{
  "name": "boldmind-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:web": "turbo run build --filter='@boldmind/*'",
    "build:api": "turbo run build --filter='@SERVICES/*'",
    "dev:hub": "turbo run dev --filter=./APPS/WEB_APPS/boldmind-hub",
    "dev:amebogist": "turbo run dev --filter=./APPS/WEB_APPS/amebogist",
    "dev:educenter": "turbo run dev --filter=./APPS/WEB_APPS/educenter",
    "dev:os": "turbo run dev --filter=./APPS/WEB_APPS/boldmind-os",
    "dev:fither": "turbo run dev --filter=./APPS/WEB_APPS/naija-fither",
    "dev:emailscraper": "turbo run dev --filter=./APPS/WEB_APPS/emailscraper-pro",
    "dev:safe-ai": "turbo run dev --filter=./APPS/WEB_APPS/safe-ai",
    "dev:social-factory": "turbo run dev --filter=./APPS/WEB_APPS/social-factory",
    "dev:planai": "turbo run dev --filter=./APPS/WEB_APPS/PLANAI_SUITE/...",
    "dev:planai-landing": "turbo run dev --filter=./APPS/WEB_APPS/PLANAI_SUITE/planai-landing",
    "dev:receptionist": "turbo run dev --filter=./APPS/WEB_APPS/PLANAI_SUITE/receptionist",
    "dev:credibility": "turbo run dev --filter=./APPS/WEB_APPS/PLANAI_SUITE/credibility-hubs",
    "dev:business-plan": "turbo run dev --filter=./APPS/WEB_APPS/PLANAI_SUITE/business-planning",
    "dev:afrohustle": "turbo run dev --filter=./APPS/CONCEPT_APPS/afrohustle-os",
    "dev:naijagig": "turbo run dev --filter=./APPS/CONCEPT_APPS/naijagig-matcher",
    "dev:kolo": "turbo run dev --filter=./APPS/CONCEPT_APPS/kolo-ai",
    "dev:concepts": "turbo run dev --filter='@boldmind/*' --filter='./APPS/CONCEPT_APPS/*'",
    "build:shared": "turbo run build --filter='@boldmind/ui' --filter='@boldmind/utils' --filter='@boldmind/auth' --filter='@boldmind/database' --filter='@boldmind/seo' --filter='@boldmind/analytics' --filter='@boldmind/ai' --filter='@boldmind/payments' --filter='@boldmind/api-client'",
    "vercel:planai-landing": "turbo run build --filter=@boldmind/planai-landing...",
    "vercel:boldmind-hub": "turbo run build --filter=@boldmind/boldmind-hub...",
    "vercel:amebogist": "turbo run build --filter=@boldmind/amebogist...",
    "vercel:educenter": "turbo run build --filter=@boldmind/educenter...",
    "vercel:planai-receptionist": "turbo run build --filter=@boldmind/planai-receptionist...",
    "dev:api": "turbo run dev --filter='@SERVICES/*'",
    "db:generate": "pnpm --filter @boldmind/database prisma generate",
    "db:migrate": "pnpm --filter @boldmind/database prisma migrate dev",
    "db:migrate:prod": "pnpm --filter @boldmind/database prisma migrate deploy",
    "db:seed": "pnpm --filter @boldmind/database prisma db seed",
    "db:studio": "pnpm --filter @boldmind/database prisma studio",
    "db:reset": "pnpm --filter @boldmind/database prisma migrate reset",
    "api:gateway": "pnpm --filter @SERVICES/api-gateway dev",
    "api:educenter": "pnpm --filter @SERVICES/educenter-service dev",
    "api:receptionist": "pnpm --filter @SERVICES/receptionist-service dev",
    "deploy:all": "sh ./tools/scripts/deploy-all.sh",
    "deploy:educenter": "sh ./tools/scripts/deploy-educenter.sh",
    "deploy:receptionist": "sh ./tools/scripts/deploy-receptionist.sh",
    "deploy:api-gateway": "sh ./tools/scripts/deploy-api-gateway.sh",
    "deploy:api-educenter": "sh ./tools/scripts/deploy-api-educenter.sh",
    "deploy:api-receptionist": "sh ./tools/scripts/deploy-api-receptionist.sh",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "rm -rf node_modules && rm -rf **/node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "dev:planai-receptionist": "turbo run dev --filter='@boldmind/planai-receptionist'",
    "dev:planai-credibility-hubs": "turbo run dev --filter='@boldmind/planai-credibility-hubs'",
    "dev:planai-business-planning": "turbo run dev --filter='@boldmind/planai-business-planning'",
    "dev:afrohustle-os": "turbo run dev --filter='@boldmind/afrohustle-os'",
    "dev:naijagig-matcher": "turbo run dev --filter='@boldmind/naijagig-matcher'",
    "dev:kolo-ai": "turbo run dev --filter='@boldmind/kolo-ai'",
    "dev:all": "turbo run dev --parallel",
    "install:all": "pnpm install && pnpm -r install",
    "update:deps": "pnpm update --latest --recursive --workspace-root",
    "check:deps": "pnpm -r exec npm outdated",
    "audit:deps": "pnpm audit --recursive",
    "fix:deps": "pnpm dedupe",
    "stats": "turbo run stats",
    "graph": "turbo run build --graph",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "turbo": "^1.13.2"
  },
  "pnpm": {
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "next": "14.2.35",
      "typescript": "5.9.3",
      "@types/react": "18.3.27",
      "@types/react-dom": "18.3.7",
      "@types/node": "20.19.30",
      "mongoose": "^8.7.0",
      "mongodb": "^6.10.0"
    }
  }
}