{
  "name": "boldmind-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "dev:all": "turbo run dev --parallel",
    "build:all": "turbo run build --parallel",
    "build:web": "turbo run build --filter='./APPS/WEB_APPS/*'",
    "build:api": "turbo run build --filter='./SERVICES/*'",
    "build:packages": "turbo run build --filter='./PACKAGES/*'",
    "build:shared": "turbo run build --filter='./PACKAGES/*'",
    "build:auth": "pnpm --filter '@boldmind/auth' run build",
    "build:utils": "pnpm --filter '@boldmind/utils' run build",
    "build:api-client": "pnpm --filter '@boldmind/api-client' run build",
    "dev:hub": "turbo run dev --filter='./APPS/WEB_APPS/boldmind-hub'",
    "dev:amebogist": "turbo run dev --filter='./APPS/WEB_APPS/amebogist'",
    "dev:educenter": "turbo run dev --filter='./APPS/WEB_APPS/educenter'",
    "dev:os": "turbo run dev --filter='./APPS/WEB_APPS/boldmind-os'",
    "dev:fither": "turbo run dev --filter='./APPS/WEB_APPS/naija-fither'",
    "dev:emailscraper": "turbo run dev --filter='./APPS/WEB_APPS/emailscraper-pro'",
    "dev:safe-ai": "turbo run dev --filter='./APPS/WEB_APPS/safe-ai'",
    "dev:social-factory": "turbo run dev --filter='./APPS/WEB_APPS/social-factory'",
    "dev:afrohustle": "turbo run dev --filter='./APPS/CONCEPT_APPS/afrohustle-os'",
    "dev:naijagig": "turbo run dev --filter='./APPS/CONCEPT_APPS/naijagig-matcher'",
    "dev:kolo": "turbo run dev --filter='./APPS/CONCEPT_APPS/kolo-ai'",
    "dev:planai": "turbo run dev --filter='./APPS/WEB_APPS/PLANAI_SUITE/*'",
    "dev:planai-landing": "turbo run dev --filter='./APPS/WEB_APPS/PLANAI_SUITE/planai-landing'",
    "dev:planai-receptionist": "turbo run dev --filter='./APPS/WEB_APPS/PLANAI_SUITE/receptionist'",
    "dev:planai-credibility": "turbo run dev --filter='./APPS/WEB_APPS/PLANAI_SUITE/credibility-hubs'",
    "dev:planai-business": "turbo run dev --filter='./APPS/WEB_APPS/PLANAI_SUITE/business-planning'",
    "dev:concepts": "turbo run dev --filter='./APPS/CONCEPT_APPS/*'",
    "dev:api": "turbo run dev --filter='./SERVICES/*'",
    "dev:api-gateway": "pnpm run build:packages && turbo run dev --filter='./SERVICES/api-gateway'",
    "dev:user-service": "turbo run dev --filter=@boldmind/user-service",
    "dev:payment-service": "turbo run dev --filter=@boldmind/payment-service",
    "dev:educenter-service": "turbo run dev --filter=@boldmind/educenter-service",
    "dev:hub-service": "turbo run dev --filter=@boldmind/hub-service",
    "dev:receptionist-service": "turbo run dev --filter=@boldmind/receptionist-service",
    "dev:amebogist-service": "turbo run dev --filter=@boldmind/amebogist-service",
    "prisma:generate:all": "pnpm run --filter './SERVICES/*' prisma:generate",
    "prisma:migrate:all": "pnpm run --filter './SERVICES/*' prisma:migrate",
    "prisma:studio:all": "pnpm run --filter './SERVICES/*' prisma:studio",
    "prisma:push:all": "pnpm run --filter './SERVICES/*' prisma:push",
    "db:generate:all": "pnpm run --filter './SERVICES/*' db:generate",
    "db:migrate:all": "pnpm run --filter './SERVICES/*' db:migrate",
    "db:push:all": "pnpm run --filter './SERVICES/*' db:push",
    "vercel:planai-landing": "turbo run build --filter='./APPS/WEB_APPS/PLANAI_SUITE/planai-landing'",
    "vercel:boldmind-hub": "turbo run build --filter='./APPS/WEB_APPS/boldmind-hub'",
    "vercel:amebogist": "turbo run build --filter='./APPS/WEB_APPS/amebogist'",
    "vercel:educenter": "turbo run build --filter='./APPS/WEB_APPS/educenter'",
    "deploy:all": "sh ./tools/scripts/deploy-all.sh",
    "deploy:educenter": "sh ./tools/scripts/deploy-educenter.sh",
    "deploy:api-gateway": "sh ./tools/scripts/deploy-api-gateway.sh",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "install:all": "pnpm install && pnpm -r install",
    "update:deps": "pnpm update --latest --recursive --workspace-root",
    "check:deps": "pnpm -r exec npm outdated",
    "audit:deps": "pnpm audit --recursive",
    "fix:deps": "pnpm dedupe",
    "clean": "rm -rf node_modules && rm -rf **/node_modules",
    "stats": "turbo run stats",
    "graph": "turbo run build --graph",
    "new-service": "tsx ./TOOLS/generators/new-service/index.ts",
    "health": "echo 'Checking monorepo health...' && pnpm run type-check && pnpm run lint && echo '✅ All checks passed'",
    "prisma:upgrade": "pnpm add -D prisma@7.3.0 @prisma/client@7.3.0 --filter='./SERVICES/*'",
    "prisma:downgrade": "pnpm add -D prisma@5.22.0 @prisma/client@5.22.0 --filter='./SERVICES/*'",
    "prisma:check-versions": "pnpm -r exec 'if [ -f \"package.json\" ]; then echo \"$PWD:\"; grep -E \"(prisma|@prisma/client)\" package.json || echo \"No Prisma\"; fi'",
    "prisma:regenerate-all": "pnpm run prisma:generate:all"
  },
  "devDependencies": {
    "@types/cookie": "^1.0.0",
    "prettier": "^3.2.5",
    "tsdown": "^0.20.1",
    "turbo": "^1.13.2",
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "next": "14.2.35",
      "typescript": "5.9.3",
      "@types/react": "18.3.27",
      "@types/react-dom": "18.3.7",
      "@types/node": "20.19.30",
      "mongoose": "^8.7.0",
      "mongodb": "^6.10.0",
      "prisma": "7.3.0",
      "@prisma/client": "7.3.0"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ]
    }
  }
}