# Use proper isolated node_modules per workspace
node-linker=pnpm

# Do NOT hoist anything unless explicitly needed
shamefully-hoist=false
hoist-pattern=[]

# Keep workspace lockfile consistent
shared-workspace-lockfile=true

# Allow peer deps to resolve without breaking builds
strict-peer-dependencies=false
auto-install-peers=true

# Make workspace linking predictable
hoist-workspace-packages=false
