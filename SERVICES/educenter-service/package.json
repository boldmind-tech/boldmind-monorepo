{
  "name": "@boldmind/educenter-service",
  "version": "1.0.0",
  "description": "EduCenter backend service with ALOC API integration",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "dotenv -e .env -- ts-node-dev --respawn --transpile-only src/index.ts",
    "deploy": "pnpm prisma:generate && pnpm build",
    "build": "tsc",
    "clean": "rm -rf dist",
    "prisma:generate": "dotenv -e .env -- prisma generate",
    "prisma:migrate": "dotenv -e .env -- prisma migrate dev",
    "prisma:migrate:deploy": "dotenv -e .env -- prisma migrate deploy",
    "prisma:studio": "dotenv -e .env -- prisma studio",
    "prisma:reset": "dotenv -e .env -- prisma migrate reset",
    "prisma:push": "dotenv -e .env -- prisma db push",
    "prisma:seed": "dotenv -e .env -- prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^5.7.0",
    "@prisma/config": "^7.3.0",
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "dotenv-cli": "^11.0.0",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.17.2",
    "prisma": "^5.7.0",
    "typescript": "^5.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.4",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/pg": "^8.16.0"
  },
  "devDependencies": {
    "tsx": "^4.7.0"
  }
}