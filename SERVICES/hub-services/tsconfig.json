{
    "extends": "../../tsconfig.backend.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": ".",
        "module": "CommonJS",
        "moduleResolution": "node",
        "lib": [
            "ES2022"
        ],
        "noPropertyAccessFromIndexSignature": false,
        "skipLibCheck": true,
        "types": [
            "node",
            "passport-jwt",
            "pg"
        ],
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "baseUrl": ".",
        "paths": {
            "@generated/*": [
                "src/generated/*"
            ]
        }
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "test"
    ]
}