{
    "name": "@boldmind/hub-service",
    "version": "1.0.0",
    "description": "Hub service for BoldMind ecosystem",
    "scripts": {
        "start": "nest start",
        "dev": "nest start --watch --preserveWatchOutput",
        "prebuild": "pnpm --filter '@boldmind/utils' build",
        "deploy": "pnpm prebuild && pnpm prisma:generate && pnpm build",
        "start:dev": "nest start --watch --preserveWatchOutput",
        "start:prod": "node dist/main",
        "build": "nest build --tsc",
        "build:dev": "nest build --watch",
        "clean": "rm -rf dist",
        "prisma:generate": "dotenv -e .env -- prisma generate",
        "prisma:migrate": "dotenv -e .env -- prisma migrate dev",
        "prisma:migrate:deploy": "dotenv -e .env -- prisma migrate deploy",
        "prisma:studio": "dotenv -e .env -- prisma studio",
        "prisma:reset": "dotenv -e .env -- prisma migrate reset",
        "prisma:push": "dotenv -e .env -- prisma db push",
        "prisma:seed": "dotenv -e .env -- prisma db seed"
    },
    "dependencies": {
        "@boldmind/utils": "workspace:*",
        "@nestjs/axios": "^4.0.1",
        "@nestjs/common": "^10.0.0",
        "@nestjs/config": "^3.3.0",
        "@nestjs/core": "^10.0.0",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/platform-express": "^10.0.0",
        "@nestjs/swagger": "^7.3.0",
        "@prisma/adapter-pg": "^7.3.0",
        "@prisma/client": "^7.3.0",
        "@prisma/config": "^7.3.0",
        "axios": "^1.6.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "dotenv": "^17.2.3",
        "helmet": "^7.1.0",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.17.2",
        "reflect-metadata": "^0.1.13",
        "rxjs": "^7.8.1",
        "swagger-ui-express": "^5.0.0",
        "dotenv-cli": "^11.0.0"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.0.0",
        "@nestjs/schematics": "^10.0.0",
        "@nestjs/testing": "^10.0.0",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.5",
        "@types/node": "^20.10.4",
        "@types/passport-jwt": "^4.0.1",
        "@types/pg": "^8.16.0",
        "@types/supertest": "^6.0.2",
        "@typescript-eslint/eslint-plugin": "^6.15.0",
        "@typescript-eslint/parser": "^6.15.0",
        "eslint": "^8.56.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.0.1",
        "jest": "^29.7.0",
        "prettier": "^3.2.5",
        "prisma": "7.3.0",
        "source-map-support": "^0.5.21",
        "supertest": "^6.3.4",
        "ts-jest": "^29.1.1",
        "ts-loader": "^9.5.1",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.3.3"
    }
}