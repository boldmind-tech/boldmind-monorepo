{
  "extends": "../../tsconfig.backend.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": [
      "ES2022"
    ],
    "noPropertyAccessFromIndexSignature": false,
    "skipLibCheck": true,
    "types": [
      "node",
      "express"
    ],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    // CRITICAL: Remove baseUrl and paths - rely on node_modules resolution
    // This forces TS to use the BUILT package from node_modules
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test"
  ]
}