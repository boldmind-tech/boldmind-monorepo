{
  "name": "@boldmind/api-gateway",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "nest start",
    "dev": "nest start --watch --preserveWatchOutput",
    "prebuild": "pnpm --filter '@boldmind/auth' --filter '@boldmind/config' build",
    "deploy": "pnpm prebuild && pnpm build",
    "start:dev": "nest start --watch --preserveWatchOutput",
    "start:prod": "node dist/main",
    "build": "pnpm prebuild && nest build --tsc",
    "build:dev": "nest build --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@boldmind/auth": "workspace:*",
    "@boldmind/config": "workspace:*",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.0.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@supabase/supabase-js": "^2.91.1",
    "@types/node": "^20.19.30",
    "@types/express": "^4.17.21",
    "axios": "^1.13.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "mongoose": "^7.4.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.0",
    "typescript": "^5.9.3",
    "validator": "^13.15.26"
  },
  "devDependencies": {
    "@types/cookie": "^1.0.0",
    "@types/passport-jwt": "^4.0.1",
    "tsx": "^4.7.0"
  }
}