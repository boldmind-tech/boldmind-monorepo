generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @map("id")
  email         String         @unique
  fullName      String?        @map("full_name")
  phone         String?
  avatarUrl     String?        @map("avatar_url")
  timezone      String?        @default("Africa/Lagos")
  locale        String?        @default("en-NG")
  isVerified    Boolean        @default(false) @map("is_verified")
  password      String?

  role          UserRole       @default(USER)
  permissions   String[]       @default([])
  isAdmin       Boolean        @default(false)
  isSuperAdmin  Boolean        @default(false)
  adminNotes    String?        @map("admin_notes")
  lastLoginAt   DateTime?      @map("last_login_at")
  loginCount    Int            @default(0) @map("login_count")

  metadata      Json?          @default("{}")

  profiles      UserProfile[]
  organizations Organization[]
  userProducts  UserProduct[]

  auditLogs         AuditLog[]
  adminAuditLogs    AuditLog[] @relation("AdminAuditLog")

  invitationsSent   Invitation[]
  systemLogs        SystemLog[]

  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("users")
}



enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EDITOR
  USER
  GUEST
  SUPPORT
  ANALYST
}

model UserProfile {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  productSlug  String   @map("product_slug")
  profileData  Json     @default("{}") @map("profile_data")
  preferences  Json     @default("{}")
  tier         String   @default("free")
  isActive     Boolean  @default(true) @map("is_active")
  lastActive   DateTime @default(now()) @map("last_active")
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  
  @@unique([userId, productSlug])
  @@index([productSlug])
  @@index([tier])
  @@map("user_profiles")
}

model Organization {
  id           String   @id @default(cuid())
  ownerId      String   @map("owner_id")
  name         String
  slug         String   @unique
  logoUrl      String?  @map("logo_url")
  industry     String?
  size         String?
  location     String?
  status       OrgStatus @default(ACTIVE)
  metadata     Json     @default("{}")
  
  owner        User     @relation(fields: [ownerId], references: [id])
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  
  @@map("organizations")
}

enum OrgStatus {
  ACTIVE
  PENDING
  SUSPENDED
  ARCHIVED
}

model UserProduct {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  productSlug  String   @map("product_slug")
  productName  String   @map("product_name")
  
  // Subscription info
  tier         String   @default("free")
  isActive     Boolean  @default(true) @map("is_active")
  subscribedAt DateTime @map("subscribed_at")
  expiresAt    DateTime? @map("expires_at")
  
  // Usage tracking
  usageCount   Int      @default(0) @map("usage_count")
  lastUsedAt   DateTime? @map("last_used_at")
  
  // Billing
  planId       String?  @map("plan_id")
  priceMonthly Decimal? @map("price_monthly") @db.Decimal(10, 2)
  currency     String?  @default("NGN")
  
  metadata     Json     @default("{}")
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  
  @@unique([userId, productSlug])
  @@index([productSlug])
  @@index([tier])
  @@index([isActive, expiresAt])
  @@map("user_products")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  adminUserId String?  @map("admin_user_id")
  
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  
  // Changes
  oldData     Json?    @map("old_data")
  newData     Json?    @map("new_data")
  changes     Json?    @map("changes")
  
  // Context
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  productSlug String?  @map("product_slug")
  
  createdAt   DateTime @default(now()) @map("created_at")
  
  user        User     @relation(fields: [userId], references: [id])
  adminUser   User?    @relation("AdminAuditLog", fields: [adminUserId], references: [id])
  
  @@index([userId])
  @@index([adminUserId])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model RolePermission {
  id          String   @id @default(cuid())
  role        UserRole
  permission  String
  description String?
  
  // Scope
  productScope String?  @map("product_scope")
  isActive     Boolean  @default(true) @map("is_active")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@unique([role, permission, productScope])
  @@index([role])
  @@map("role_permissions")
}

model Invitation {
  id          String   @id @default(cuid())
  email       String   @unique
  token       String   @unique
  role        UserRole @default(USER)
  
  // Inviter
  invitedById String   @map("invited_by_id")
  
  // Status
  status      InvitationStatus @default(PENDING)
  acceptedAt  DateTime? @map("accepted_at")
  expiresAt   DateTime  @map("expires_at")
  
  // Product scope
  productScope String[] @map("product_scope") @db.Text
  
  metadata     Json     @default("{}")
  
  invitedBy    User     @relation(fields: [invitedById], references: [id])
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  
  @@index([email])
  @@index([token])
  @@index([status, expiresAt])
  @@map("invitations")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model SystemLog {
  id          String   @id @default(cuid())
  level       LogLevel @default(INFO)
  message     String
  source      String
  context     Json?    @db.JsonB
  
  stackTrace  String?  @map("stack_trace")
  errorCode   String?  @map("error_code")
  
  userId      String?  @map("user_id")
  
  createdAt   DateTime @default(now()) @map("created_at")
  
  user        User?    @relation(fields: [userId], references: [id])
  
  @@index([level, createdAt])
  @@index([source, createdAt])
  @@index([userId])
  @@map("system_logs")
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}