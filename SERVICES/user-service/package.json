{
  "name": "@boldmind/user-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "nest start",
    "dev": "nest start --watch --preserveWatchOutput",
    "prebuild": "pnpm --filter '@boldmind/config' --filter '@boldmind/utils' build",
    "deploy": "pnpm prebuild && pnpm prisma:generate && pnpm build",
    "start:dev": "nest start --watch --preserveWatchOutput",
    "start:prod": "node dist/main",
    "build": "pnpm prebuild && nest build --tsc",
    "build:dev": "nest build --watch",
    "clean": "rm -rf dist",
    "prisma:generate": "dotenv -e .env -- prisma generate",
    "prisma:migrate": "dotenv -e .env -- prisma migrate dev",
    "prisma:migrate:deploy": "dotenv -e .env -- prisma migrate deploy",
    "prisma:studio": "dotenv -e .env -- prisma studio",
    "prisma:reset": "dotenv -e .env -- prisma migrate reset",
    "prisma:push": "dotenv -e .env -- prisma db push",
    "prisma:seed": "dotenv -e .env -- prisma db seed"
  },
  "dependencies": {
    "@boldmind/config": "workspace:*",
    "@boldmind/utils": "workspace:*",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.0.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "7.3.0",
    "@prisma/client-runtime-utils": "7.3.0",
    "@prisma/config": "^7.3.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "mongoose": "^7.4.0",
    "pg": "^8.17.2",
    "prisma": "7.3.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.0",
    "typescript": "^5.1.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie": "^1.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "20.19.30",
    "@types/pg": "^8.16.0"
  }
}