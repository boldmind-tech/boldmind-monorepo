{
  "name": "@boldmind/payment-service",
  "version": "1.0.0",
  "description": "Payment processing service with Paystack and Flutterwave",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "",
    "build": "pnpm prisma:generate && tsc && copyfiles -u 1 \"src/generated/client/**/*\" dist",
    "deploy": "pnpm prebuild turbo build --filter=@boldmind/payment-service",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e .env -- prisma migrate",
    "prisma:migrate:deploy": "dotenv -e .env -- prisma migrate deploy",
    "prisma:studio": "dotenv -e .env -- prisma studio",
    "prisma:reset": "dotenv -e .env -- prisma migrate reset",
    "prisma:push": "dotenv -e .env -- prisma db push",
    "prisma:seed": "dotenv -e .env -- prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@prisma/config": "^7.3.0",
    "@prisma/client-runtime-utils": "^7.3.0",
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "dotenv-cli": "^11.0.0",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.17.2",
    "prisma": "^7.3.0",
    "typescript": "^5.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.4",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/pg": "^8.16.0"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "copyfiles": "^2.4.1"
  }
}