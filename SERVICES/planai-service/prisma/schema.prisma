// SERVICES/planai-service/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PLANAI_SERVICE_DATABASE_URL")
}

// ==================== AI RECEPTIONIST ====================
model ReceptionistClient {
  id              String   @id @default(uuid())
  organizationId  String?  @db.Uuid
  userId          String   @db.Uuid
  
  // Business Details
  businessName    String   @db.VarChar(255)
  industry        String?  @db.VarChar(100)
  contactEmail    String?  @db.VarChar(255)
  contactPhone    String?  @db.VarChar(50)
  
  // Social Links (JSON)
  socialLinks     Json?    @db.JsonB
  
  // Working Hours (JSON)
  workingHours    Json     @db.JsonB
  timezone        String   @default("Africa/Lagos")
  
  // AI Configuration (JSON)
  aiPersonality   Json     @db.JsonB
  
  // Response Templates
  greetingMessage String?  @db.Text
  awayMessage     String?  @db.Text
  
  // Auto-Response Settings
  autoReply       Boolean  @default(true)
  qualifyLeads    Boolean  @default(true)
  bookAppointments Boolean @default(false)
  
  // Status
  isActive        Boolean  @default(true)
  
  // Subscription
  subscriptionTier String  @default("basic")
  
  // Stats
  totalLeads      Int      @default(0)
  qualifiedLeads  Int      @default(0)
  responseRate    Decimal? @db.Decimal(5, 2)
  avgResponseTime Int?     // in seconds
  
  // Metadata
  metadata        Json     @default("{}") @db.JsonB
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  leads           Lead[]
  conversations   Conversation[]
  
  @@index([userId])
  @@index([isActive])
  @@map("receptionist_clients")
}

// ==================== LEADS ====================
model Lead {
  id          String   @id @default(uuid())
  clientId    String   @db.Uuid
  
  // Lead Source
  source      LeadSource
  
  // Contact Info
  contactName String?  @db.VarChar(255)
  contactInfo String   @db.VarChar(500) // phone, email, or username
  
  // First Message
  message     String   @db.Text
  
  // Classification
  status      LeadStatus @default(NEW)
  priority    Priority   @default(MEDIUM)
  
  // Lead Score (AI-calculated)
  leadScore   Int      @default(50) // 0-100
  
  // Qualification
  isQualified Boolean  @default(false)
  qualificationNotes Json? @db.JsonB
  
  // Assignment
  assignedTo  String?  @db.Uuid
  
  // Interaction
  lastInteraction DateTime @default(now())
  interactionCount Int   @default(1)
  
  // Notes (JSON array)
  notes       Json     @default("[]") @db.JsonB
  
  // Tags
  tags        String[] @db.Text
  
  // Metadata
  metadata    Json     @default("{}") @db.JsonB
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  client      ReceptionistClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  
  @@index([clientId])
  @@index([status])
  @@index([priority])
  @@index([source])
  @@index([createdAt])
  @@map("leads")
}

enum LeadSource {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  WEBSITE
  EMAIL
  PHONE
  TWITTER
  LINKEDIN
  TELEGRAM
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  NEGOTIATING
  CONVERTED
  LOST
  NURTURING
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ==================== CONVERSATIONS ====================
model Conversation {
  id          String   @id @default(uuid())
  clientId    String   @db.Uuid
  leadId      String?  @db.Uuid
  
  // Platform Details
  platform    LeadSource
  platformUserId String? @db.VarChar(255)
  
  // Conversation
  messages    Json     @db.JsonB // Array of messages
  
  // Status
  isActive    Boolean  @default(true)
  isResolved  Boolean  @default(false)
  
  // Metadata
  lastMessageAt DateTime @default(now())
  messageCount  Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  client      ReceptionistClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lead        Lead?              @relation(fields: [leadId], references: [id])
  
  @@index([clientId])
  @@index([leadId])
  @@index([platform])
  @@map("conversations")
}

// ==================== BUSINESS PLANS ====================
model BusinessPlan {
  id              String   @id @default(uuid())
  userId          String   @db.Uuid
  
  // Business Details
  businessName    String   @db.VarChar(255)
  industry        String   @db.VarChar(100)
  
  // Plan Sections
  executiveSummary String?  @db.Text
  problemStatement String?  @db.Text
  solution        String?  @db.Text
  targetMarket    String?  @db.Text
  
  // Analysis (JSON)
  competitionAnalysis Json? @db.JsonB
  marketAnalysis      Json? @db.JsonB
  
  // Strategy (JSON)
  marketingStrategy   Json? @db.JsonB
  operationsStrategy  Json? @db.JsonB
  
  // Financials (JSON)
  financialProjections Json? @db.JsonB
  fundingRequirements  Json? @db.JsonB
  
  // Team (JSON)
  team            Json?    @db.JsonB
  
  // Status
  status          PlanStatus @default(DRAFT)
  completeness    Int      @default(0) // 0-100%
  
  // Versioning
  version         Int      @default(1)
  lastGeneratedAt DateTime @default(now())
  
  // Export
  exportedPdfUrl  String?  @db.Text
  
  // Metadata
  metadata        Json     @default("{}") @db.JsonB
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  financialModels FinancialModel[]
  
  @@index([userId])
  @@index([status])
  @@map("business_plans")
}

enum PlanStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

// ==================== FINANCIAL MODELS ====================
model FinancialModel {
  id              String   @id @default(uuid())
  businessPlanId  String   @db.Uuid
  
  // Model Type
  modelType       ModelType
  timePeriod      TimePeriod
  
  // Data (JSON)
  data            Json     @db.JsonB
  
  // Assumptions (JSON)
  assumptions     Json?    @db.JsonB
  
  // Analysis
  summary         String?  @db.Text
  insights        Json?    @db.JsonB
  
  // Charts/Visualization Data
  chartData       Json?    @db.JsonB
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  businessPlan    BusinessPlan @relation(fields: [businessPlanId], references: [id], onDelete: Cascade)
  
  @@index([businessPlanId])
  @@map("financial_models")
}

enum ModelType {
  REVENUE
  EXPENSES
  CASHFLOW
  PROFIT_LOSS
  BALANCE_SHEET
  BREAK_EVEN
}

enum TimePeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

// ==================== PORTFOLIOS (Credibility Hubs) ====================
model Portfolio {
  id              String   @id @default(uuid())
  userId          String   @unique @db.Uuid
  
  // Profile
  headline        String?  @db.VarChar(255)
  bio             String?  @db.Text
  profilePhoto    String?  @db.Text
  
  // Skills
  skills          String[] @db.Text
  
  // Experience (JSON)
  experience      Json     @default("[]") @db.JsonB
  
  // Education (JSON)
  education       Json     @default("[]") @db.JsonB
  
  // Projects (JSON)
  projects        Json     @default("[]") @db.JsonB
  
  // Certifications (JSON)
  certifications  Json     @default("[]") @db.JsonB
  
  // Testimonials (JSON)
  testimonials    Json     @default("[]") @db.JsonB
  
  // Social Links (JSON)
  socialLinks     Json     @default("{}") @db.JsonB
  
  // Customization
  customDomain    String?  @unique @db.VarChar(255)
  slug            String   @unique @db.VarChar(100)
  theme           String   @default("default")
  customCSS       String?  @db.Text
  
  // SEO
  metaTitle       String?  @db.VarChar(255)
  metaDescription String?  @db.Text
  
  // Publishing
  isPublished     Boolean  @default(false)
  publishedAt     DateTime?
  
  // Analytics
  viewsCount      Int      @default(0)
  uniqueVisitors  Int      @default(0)
  
  // Metadata
  metadata        Json     @default("{}") @db.JsonB
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([isPublished])
  @@index([slug])
  @@map("portfolios")
}

// ==================== DIGITAL STOREFRONTS ====================
model Storefront {
  id              String   @id @default(uuid())
  organizationId  String?  @db.Uuid
  userId          String   @db.Uuid
  
  // Store Details
  storeName       String   @db.VarChar(255)
  storeSlug       String   @unique @db.VarChar(100)
  description     String?  @db.Text
  logo            String?  @db.Text
  
  // Contact
  contactEmail    String?  @db.VarChar(255)
  contactPhone    String?  @db.VarChar(50)
  
  // Address (JSON)
  address         Json?    @db.JsonB
  
  // Social Links (JSON)
  socialLinks     Json?    @db.JsonB
  
  // Theme Configuration (JSON)
  themeConfig     Json     @default("{}") @db.JsonB
  customDomain    String?  @unique @db.VarChar(255)
  
  // Business Settings
  currency        String   @default("NGN")
  taxRate         Decimal? @db.Decimal(5, 2)
  
  // Shipping
  shippingEnabled Boolean  @default(true)
  shippingZones   Json?    @db.JsonB
  
  // Payment Methods
  paymentMethods  String[] @db.Text
  
  // Status
  isActive        Boolean  @default(false)
  isPublished     Boolean  @default(false)
  publishedAt     DateTime?
  
  // Stats
  totalProducts   Int      @default(0)
  totalOrders     Int      @default(0)
  totalRevenue    Decimal  @default(0) @db.Decimal(12, 2)
  
  // Metadata
  metadata        Json     @default("{}") @db.JsonB
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  products        Product[]
  orders          Order[]
  
  @@index([userId])
  @@index([isPublished])
  @@index([storeSlug])
  @@map("storefronts")
}

// ==================== MARKETING AUTOMATION ================

model MarketingCampaign {
  id              String   @id @default(uuid())
  organizationId  String?  @db.Uuid
  userId          String   @db.Uuid

  name            String   @db.VarChar(255)
  channel         MarketingChannel

  // Automation Logic
  triggerConfig   Json     @db.JsonB
  workflow        Json     @db.JsonB

  // Performance
  sentCount       Int      @default(0)
  openRate        Decimal? @db.Decimal(5,2)
  clickRate       Decimal? @db.Decimal(5,2)
  conversionRate  Decimal? @db.Decimal(5,2)

  isActive        Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([channel])
  @@map("marketing_campaigns")
}

enum MarketingChannel {
  EMAIL
  WHATSAPP
  SMS
  PUSH
}

// =================== ANALYTICS DASHBOARD ====================

model AnalyticsSnapshot {
  id              String   @id @default(uuid())
  organizationId  String?  @db.Uuid
  userId          String   @db.Uuid

  source          String   @db.VarChar(100) // storefront, receptionist, marketing
  metrics         Json     @db.JsonB

  periodStart     DateTime
  periodEnd       DateTime

  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([source])
  @@map("analytics_snapshots")
}

// =================== INVESTOR READINESS SUITE====================

model InvestorProfile {
  id              String   @id @default(uuid())
  organizationId  String   @db.Uuid

  stage           StartupStage
  valuation       Decimal? @db.Decimal(15,2)
  fundingGoal     Decimal? @db.Decimal(15,2)

  pitchDeckUrl    String?  @db.Text
  dataRoomConfig  Json?    @db.JsonB

  readinessScore  Int      @default(0) // 0–100

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("investor_profiles")
}

enum StartupStage {
  IDEA
  MVP
  TRACTION
  REVENUE
  SCALE
}

model InvestorPitchDeck {
  id              String   @id @default(uuid())
  organizationId  String   @db.Uuid

  title           String   @db.VarChar(255)
  version         String   @db.VarChar(50)
  content         Json     @db.JsonB

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("investor_pitch_decks")
}

model InvestorDataRoom {
  id              String   @id @default(uuid())
  organizationId  String   @db.Uuid

  name            String   @db.VarChar(255)
  description     String?  @db.Text

  files           Json     @db.JsonB // Array of file metadata
  accessConfig    Json     @db.JsonB // Permissions, etc.

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("investor_data_rooms")
}

model InvestorDealFlow {
  id              String   @id @default(uuid())
  organizationId  String   @db.Uuid

  investorName    String   @db.VarChar(255)
  investorType    String   @db.VarChar(100) // Angel, VC, etc.
  stageFocus      String   @db.VarChar(100)

  dealSize        Decimal? @db.Decimal(15,2)
  investmentThesis String?  @db.Text

  status          DealStatus @default(NEW)
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("investor_deal_flows")
}

enum DealStatus {
  NEW
  CONTACTED
  PITCHED
  DUE_DILIGENCE
  TERM_SHEET
  CLOSED
  REJECTED
}

// ================= BRANDING & DESIGN TOOLS====================

model BrandKit {
  id              String   @id @default(uuid())
  organizationId  String?  @db.Uuid
  userId          String   @db.Uuid

  brandName       String   @db.VarChar(255)
  logoAssets      Json     @default("[]") @db.JsonB
  colorPalette    Json     @default("{}") @db.JsonB
  typography      Json     @default("{}") @db.JsonB

  guidelines      Json?    @db.JsonB

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("brand_kits")
}

// =================== PLANAI SUBSCRIPTIONS & BILLING====================

model PlanAISubscription {
  id              String   @id @default(uuid())
  userId          String   @db.Uuid
  organizationId  String?  @db.Uuid

  plan            PlanAIPlan
  status          SubscriptionStatus

  startedAt       DateTime @default(now())
  expiresAt       DateTime?

  metadata        Json     @default("{}") @db.JsonB

  @@index([userId])
  @@map("planai_subscriptions")
}

enum PlanAIPlan {
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

// =================== AI USAGE / CREDITS ====================

model AIUsageLog {
  id          String   @id @default(uuid())
  userId      String   @db.Uuid

  product     String   @db.VarChar(100)
  action      String   @db.VarChar(100)

  tokensUsed  Int
  cost        Decimal? @db.Decimal(10,4)

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([product])
  @@map("ai_usage_logs")
}

// =================== ORGANIZATIONS ================

model Organization {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(100)

  ownerId     String   @db.Uuid

  settings    Json     @default("{}") @db.JsonB
  metadata    Json     @default("{}") @db.JsonB

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     OrganizationMember[]

  @@map("organizations")
}

model OrganizationMember {
  id              String   @id @default(uuid())
  organizationId  String   @db.Uuid
  userId          String   @db.Uuid
  role            OrgRole

  createdAt       DateTime @default(now())

  @@unique([organizationId, userId])
  @@map("organization_members")
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}


// ==================== PRODUCTS ====================
model Product {
  id              String   @id @default(uuid())
  storefrontId    String   @db.Uuid
  
  // Product Details
  name            String   @db.VarChar(255)
  slug            String   @db.VarChar(255)
  description     String?  @db.Text
  
  // Pricing
  price           Decimal  @db.Decimal(10, 2)
  compareAtPrice  Decimal? @db.Decimal(10, 2)
  costPrice       Decimal? @db.Decimal(10, 2)
  
  // SKU & Tracking
  sku             String?  @db.VarChar(100)
  barcode         String?  @db.VarChar(100)
  
  // Physical Properties
  weightKg        Decimal? @db.Decimal(8, 3)
  dimensions      Json?    @db.JsonB
  
  // Inventory
  inventoryQuantity Int    @default(0)
  trackInventory  Boolean  @default(true)
  allowBackorder  Boolean  @default(false)
  lowStockThreshold Int?   @default(5)
  
  // Visibility
  isVisible       Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  
  // Categories & Tags
  category        String?  @db.VarChar(100)
  tags            String[] @db.Text
  
  // Media (JSON)
  images          Json     @default("[]") @db.JsonB
  
  // Variants (JSON)
  variants        Json     @default("[]") @db.JsonB
  
  // SEO
  metaTitle       String?  @db.VarChar(255)
  metaDescription String?  @db.Text
  
  // Stats
  viewCount       Int      @default(0)
  salesCount      Int      @default(0)
  rating          Decimal? @db.Decimal(3, 2)
  reviewCount     Int      @default(0)
  
  // Metadata
  metadata        Json     @default("{}") @db.JsonB
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  storefront      Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]
  
  @@unique([storefrontId, slug])
  @@index([storefrontId])
  @@index([isVisible])
  @@index([isFeatured])
  @@map("products")
}

// ==================== ORDERS ====================
model Order {
  id              String   @id @default(uuid())
  storefrontId    String   @db.Uuid
  userId          String?  @db.Uuid
  
  // Order Number
  orderNumber     String   @unique @db.VarChar(50)
  
  // Customer Info
  customerEmail   String   @db.VarChar(255)
  customerPhone   String?  @db.VarChar(50)
  customerName    String   @db.VarChar(255)
  
  // Shipping Address (JSON)
  shippingAddress Json     @db.JsonB
  
  // Billing Address (JSON)
  billingAddress  Json?    @db.JsonB
  
  // Totals
  subtotal        Decimal  @db.Decimal(10, 2)
  shippingCost    Decimal  @default(0) @db.Decimal(10, 2)
  tax             Decimal  @default(0) @db.Decimal(10, 2)
  discount        Decimal  @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal  @db.Decimal(10, 2)
  
  // Payment
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   String?  @db.VarChar(100)
  paymentRef      String?  @db.VarChar(255)
  paidAt          DateTime?
  
  // Fulfillment
  fulfillmentStatus FulfillmentStatus @default(PENDING)
  trackingNumber  String?  @db.VarChar(255)
  trackingUrl     String?  @db.Text
  shippedAt       DateTime?
  deliveredAt     DateTime?
  
  // Cancellation
  cancelledAt     DateTime?
  cancellationReason String? @db.Text
  
  // Notes
  customerNotes   String?  @db.Text
  internalNotes   String?  @db.Text
  
  // Metadata
  metadata        Json     @default("{}") @db.JsonB
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  storefront      Storefront @relation(fields: [storefrontId], references: [id])
  items           OrderItem[]
  
  @@index([storefrontId])
  @@index([userId])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([createdAt])
  @@map("orders")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

// ==================== ORDER ITEMS ====================
model OrderItem {
  id          String  @id @default(uuid())
  orderId     String  @db.Uuid
  productId   String  @db.Uuid
  
  // Product Details (at time of order)
  productName String  @db.VarChar(255)
  variantName String? @db.VarChar(255)
  sku         String? @db.VarChar(100)
  
  // Pricing
  price       Decimal @db.Decimal(10, 2)
  quantity    Int
  subtotal    Decimal @db.Decimal(10, 2)
  
  // Metadata
  metadata    Json    @default("{}") @db.JsonB
  
  // Relations
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])
  
  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}